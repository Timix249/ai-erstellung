# Лише на сервері. Ніколи не додавай секрети в public/ чи Git.
GEMINI_API_KEY=
# Довгий пароль для входу на публічний сайт.
APP_PASSWORD=
PORT=3000
# Для власного домену: точна HTTPS-адреса без кінцевого /.
# APP_ORIGIN=https://assistant.example.com
# NODE_ENV=production
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
GEMINI_SPEECH_MODEL=gemini-3.8-flash-tts

# Optional: Google-Anmeldung und geräteübergreifende Synchronisierung.
# Supabase: Projekt-Einstellungen → Data API / API Keys (nur Publishable/anon, KEIN service_role).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Erlaubte Google-Adressen, durch Kommas getrennt; keine öffentliche Registrierung.
ALLOWED_GOOGLE_EMAILS=
# Auf Render automatisch über RENDER_EXTERNAL_URL, sonst APP_ORIGIN setzen.
