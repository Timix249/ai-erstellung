# Nur auf dem Server eintragen. Niemals in public/ ablegen oder committen.
GEMINI_API_KEY=
# Für öffentlich erreichbare Server erforderlich: langes, zufälliges Passwort.
APP_PASSWORD=
PORT=3000
# Bei Veröffentlichung exakt die öffentliche HTTPS-Adresse, ohne abschließenden /:
# APP_ORIGIN=https://assistent.example.de
# NODE_ENV=production
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_AUDIO_MODEL=gemini-3.1-flash-lite
GEMINI_SPEECH_MODEL=gemini-3.8-flash-tts
