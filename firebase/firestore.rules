rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wolke_users/{userId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId
          && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      allow read: if owner();
      allow create: if owner()
        && request.resource.data.keys().hasOnly(['revision', 'data'])
        && request.resource.data.revision == 1
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 750000;
      allow update: if owner()
        && request.resource.data.keys().hasOnly(['revision', 'data'])
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 750000;
      allow delete: if owner();
    }
  }
}
